---
import Layout from '../../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('posts',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
---
<Layout title={post.data.title}><article class="page prose"><a class="text-link" href="/journal/">← 返回日常</a><p class="meta">{post.data.category} / {post.data.date.toISOString().slice(0,10)}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p><hr/><Content/></article></Layout>