---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
---
<Layout title="日常手记"><section class="page"><p class="eyebrow">LIFE, IN LITTLE CHAPTERS</p><h1>日常手记</h1><p class="intro">一些走过的路，一些留下的念头。</p>{posts.map(post=><a class="entry" href={'/posts/'+post.id+'/'}><div><div class="meta">{post.data.category} / {post.data.date.toISOString().slice(0,10)}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="entry-arrow">↗</span></a>)}</section></Layout>