---
import profile from '../data/profile.json';
const {large=false}=Astro.props;
const original=profile.avatar === '/uploads/harlan-portrait-original.jpg';
---
{profile.avatar && <div class:list={['avatar-frame',{large}]}><img class:list={{'portrait-crop':original}} src={profile.avatar} alt={`${profile.name}的头像`} width="128" height="128" /></div>}
<style>
.avatar-frame{width:92px;height:92px;border-radius:50%;overflow:hidden;position:relative;margin-bottom:25px;border:3px solid #fffdf8;box-shadow:0 0 0 1px #d9d9c9,0 6px 20px #343b3010;background:#e9e4d6}
.avatar-frame.large{width:132px;height:132px;margin-bottom:32px}
img{display:block;width:100%;height:100%;object-fit:cover}
img.portrait-crop{position:absolute;width:213.167%;max-width:none;height:auto;left:-35.833%;top:-58.333%}
</style>
