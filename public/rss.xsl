<?xml version="1.0" encoding="UTF-8"?><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><html lang="zh-CN"><head><title>日子慢慢 · RSS</title><meta name="viewport" content="width=device-width"/><style>body{background:#f7f5f0;color:#343a30;font:18px/1.9 Georgia,serif;max-width:720px;margin:60px auto;padding:24px}a{color:#68745c}article{border-top:1px solid #deddd2;padding:24px 0}p{color:#74756b}small{font-size:13px}</style></head><body><a href="/">← 返回博客</a><h1><xsl:value-of select="rss/channel/title"/> · RSS</h1><p>这是一份可订阅的 RSS。将本页地址添加到阅读器，接收新的日常手记。</p><xsl:for-each select="rss/channel/item"><article><small><xsl:value-of select="pubDate"/></small><h2><a href="{link}"><xsl:value-of select="title"/></a></h2><p><xsl:value-of select="description"/></p></article></xsl:for-each></body></html></xsl:template></xsl:stylesheet>